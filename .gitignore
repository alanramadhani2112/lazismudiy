# Ignore everything by default.
*

# Track project docs/config.
!.gitignore
!README.md
!DEVELOPMENT_PLAN.md
!CHANGELOG.md
!MIGRATION_PLAN.md
!REDIRECT_MAPPING.md
!QA_CHECKLIST.md
!LAUNCH_CHECKLIST.md
!package.json
!package-lock.json
!tailwind.config.js
!postcss.config.js
!vite.config.js

# Track custom theme.
!wp-content/
!wp-content/themes/
!wp-content/themes/lazismu-diy/
!wp-content/themes/lazismu-diy/**

# Track custom plugins.
!wp-content/plugins/
!wp-content/plugins/lazismu-core/
!wp-content/plugins/lazismu-core/**
!wp-content/plugins/lazismu-donation/
!wp-content/plugins/lazismu-donation/**
!wp-content/plugins/lazismu-zakat/
!wp-content/plugins/lazismu-zakat/**
!wp-content/plugins/lazismu-reporting/
!wp-content/plugins/lazismu-reporting/**

# Local/sensitive.
wp-config.php
.env
*.log

# Dependencies.
node_modules/
